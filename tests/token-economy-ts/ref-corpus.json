{
  "version": 1,
  "description": "Контрактные фикстуры грамматики refs для graph op=read ref= (этап W3 плана 20+21 v3). Единая грамматика с MegaMemory src/refs.ts (classifyRef/parseRef). Данные не исполняются как скрипты: ref-corpus.test.js сверяет разбор lib/refs.js с полем parse, ref-read.test.js проверяет поведение чтения на реальных временных файлах. Распознанный вид ≠ поддержанный способ чтения.",
  "supported_read_kinds": ["path", "path:N", "path:N-M", "path#LN", "path#LN-LM"],
  "refusal_codes": ["range_required", "unsupported_ref_kind", "conflicting_args", "line_too_long"],
  "cases": [
    {"id": "bare", "raw": "src/app.ts", "parse": {"kind": "file", "path": "src/app.ts"}},
    {"id": "single-line", "raw": "src/app.ts:10", "parse": {"kind": "file", "path": "src/app.ts", "start": 10, "end": 10}},
    {"id": "inclusive-range", "raw": "src/app.ts:10-20", "parse": {"kind": "file", "path": "src/app.ts", "start": 10, "end": 20}},
    {"id": "hash-single", "raw": "src/app.ts#L10", "parse": {"kind": "file", "path": "src/app.ts", "start": 10, "end": 10}},
    {"id": "hash-range", "raw": "src/app.ts#L10-L20", "parse": {"kind": "file", "path": "src/app.ts", "start": 10, "end": 20}},
    {"id": "cyrillic-and-spaces", "raw": "документы/файл с именем.ts:5", "parse": {"kind": "file", "path": "документы/файл с именем.ts", "start": 5, "end": 5}},
    {"id": "cyrillic-bare", "raw": "отчёт итог.md", "parse": {"kind": "file", "path": "отчёт итог.md"}},
    {"id": "windows-drive-range", "raw": "C:\\prj\\src\\a.ts:3-4", "parse": {"kind": "file", "path": "C:\\prj\\src\\a.ts", "start": 3, "end": 4}},
    {"id": "windows-drive-bare", "raw": "C:\\prj\\src\\a.ts", "parse": {"kind": "file", "path": "C:\\prj\\src\\a.ts"}},
    {"id": "windows-drive-colon-in-name", "raw": "C:\\src:folder\\a.ts#L2", "parse": {"kind": "file", "path": "C:\\src:folder\\a.ts", "start": 2, "end": 2}},
    {"id": "unc-range", "raw": "\\\\srv\\share\\src\\a.ts:7", "parse": {"kind": "file", "path": "\\\\srv\\share\\src\\a.ts", "start": 7, "end": 7}},
    {"id": "unc-hash-range", "raw": "\\\\srv\\share\\src\\a.ts#L7-L9", "parse": {"kind": "file", "path": "\\\\srv\\share\\src\\a.ts", "start": 7, "end": 9}},
    {"id": "hash-inside-name-with-locator", "raw": "a#b.ts:10", "parse": {"kind": "file", "path": "a#b.ts", "start": 10, "end": 10}},
    {"id": "hash-locator-shape-is-name", "raw": "a#L12.ts", "parse": {"kind": "file", "path": "a#L12.ts"}},
    {"id": "colon-tail-not-locator", "raw": "src/db.ts:abc", "parse": {"kind": "file", "path": "src/db.ts:abc"}},
    {"id": "colon-inside-name", "raw": "a:b.ts", "parse": {"kind": "file", "path": "a:b.ts"}},
    {"id": "trailing-colon-is-name", "raw": "f.txt:", "parse": {"kind": "file", "path": "f.txt:"}},
    {"id": "double-hyphen-tail-is-name", "raw": "f.txt:1-2-3", "parse": {"kind": "file", "path": "f.txt:1-2-3"}},
    {"id": "reversed-range-parse", "raw": "f.txt:5-2", "parse": {"kind": "file", "path": "f.txt", "start": 5, "end": 2}},
    {"id": "zero-line-parse", "raw": "f.txt:0", "parse": {"kind": "file", "path": "f.txt", "start": 0, "end": 0}},
    {"id": "zero-hash-parse", "raw": "f.txt#L0", "parse": {"kind": "file", "path": "f.txt", "start": 0, "end": 0}},
    {"id": "beyond-file-parse", "raw": "f.txt:2-99999", "parse": {"kind": "file", "path": "f.txt", "start": 2, "end": 99999}},
    {"id": "git-ref-tag", "raw": "git:tag:2026", "parse": {"kind": "git_ref", "scheme": "tag", "name": "2026"}},
    {"id": "git-ref-commit", "raw": "git:commit:abc123", "parse": {"kind": "git_ref", "scheme": "commit", "name": "abc123"}},
    {"id": "git-ref-branch", "raw": "git:branch:feature/x", "parse": {"kind": "git_ref", "scheme": "branch", "name": "feature/x"}},
    {"id": "git-ref-invalid-name-is-file", "raw": "git:tag:-bad", "parse": {"kind": "file", "path": "git:tag:-bad"}},
    {"id": "git-blob-head", "raw": "HEAD:src/a.ts", "parse": {"kind": "git_blob", "rev": "HEAD", "path": "src/a.ts"}},
    {"id": "git-blob-sha7", "raw": "abc1234:path/f.ts", "parse": {"kind": "git_blob", "rev": "abc1234", "path": "path/f.ts"}},
    {"id": "git-blob-sha40", "raw": "0123456789abcdef0123456789abcdef01234567:src/a.ts", "parse": {"kind": "git_blob", "rev": "0123456789abcdef0123456789abcdef01234567", "path": "src/a.ts"}},
    {"id": "short-hex-is-file", "raw": "abc12:path/f.ts", "parse": {"kind": "file", "path": "abc12:path/f.ts"}},
    {"id": "traversal-parse", "raw": "../outside.txt:1", "parse": {"kind": "file", "path": "../outside.txt", "start": 1, "end": 1}},
    {"id": "traversal-deep", "raw": "a/../../outside.txt", "parse": {"kind": "file", "path": "a/../../outside.txt"}}
  ]
}
