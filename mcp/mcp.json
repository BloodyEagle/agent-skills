{
  "$schema": "https://app.kilo.ai/config.json",
  "mcp": {
    "firefox-devtools": {
      "type": "local",
      "command": [
        "npx",
        "-y",
        "@mozilla/firefox-devtools-mcp",
        "--connect-existing",
        "--marionette-port",
        "2828"
      ],
      "enabled": false
    },
    "chrome-devtools": {
      "type": "local",
      "command": [
        "npx",
        "-y",
        "chrome-devtools-mcp@latest",
        "--autoConnect"
      ],
      "enabled": false
    },
    "megamemory": {
      "type": "local",
      "command": ["megamemory"],
      "enabled": true
    },
	"playwright": {
      "command": ["npx",
			"@playwright/mcp@latest"
      ]
    }
  }
}
